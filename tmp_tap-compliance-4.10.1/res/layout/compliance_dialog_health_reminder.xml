<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="335dp"
    android:layout_height="320dp"
    android:background="@drawable/compliance_bg_white_radius_8dp"
    android:orientation="vertical">

    <include
        android:id="@+id/include_title_bar"
        layout="@layout/compliance_dialog_common_title_bar" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tv_limit_tips"
            style="@style/compliance_common_text_style"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:scrollbars="vertical"
            tools:text="您的账号未完成实名认证，为了符合国家相关规定，不影响您的游戏体验，请尽快完善实名信息。" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/tv_alert_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_function_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/compliance_alert_negative_gray_bg"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="6dp"
            android:text="退出游戏"
            android:textColor="@android:color/black"
            android:textSize="12dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_switch_account_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/compliance_alert_positive_bg"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="6dp"
            android:text="切换账号"
            android:textColor="@android:color/white"
            android:textSize="12dp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>